{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/contratar/admin",
      "destination": "/contratar/admin/index.html"
    },
    {
      "source": "/contratar/admin/",
      "destination": "/contratar/admin/index.html"
    },
    {
      "source": "/contratar/:slug/admin",
      "destination": "/contratar/entre-estacoes/admin/index.html"
    },
    {
      "source": "/contratar/:slug/admin/",
      "destination": "/contratar/entre-estacoes/admin/index.html"
    },
    {
      "source": "/contratar/natal-fada-acucarada-2026",
      "destination": "/contratar/fada-natal/index.html"
    },
    {
      "source": "/contratar/natal-fada-acucarada-2026/",
      "destination": "/contratar/fada-natal/index.html"
    },
    {
      "source": "/contratar/:slug",
      "destination": "/contratar/entre-estacoes/index.html"
    },
    {
      "source": "/contratar/:slug/",
      "destination": "/contratar/entre-estacoes/index.html"
    }
  ]
}
